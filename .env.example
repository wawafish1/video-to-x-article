OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=

# You can change these without touching code.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Keep under typical transcription upload limits.
MAX_TRANSCRIPTION_MB=23

# Reject unexpectedly large source videos before they fill local storage.
MAX_UPLOAD_MB=1024
